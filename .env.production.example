# VPS এ .env.production নামে কপি করে আসল মান বসান — এই ফাইলটা কখনো git এ commit হবে না
# (docker-compose.production.yml এই ফাইল থেকে web আর worker দুটো কন্টেইনারেই এনভ লোড করে)

# ============================================================
# Supabase (লাইভ প্রজেক্ট — Supabase Dashboard > Settings > API)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# শুধু server-side — RLS bypass করে, কখনো browser এ পাঠাবেন না
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Redis (এই কম্পোজের ভিতরের redis সার্ভিস, বাইরে থেকে অ্যাক্সেসযোগ্য না)
# পাসওয়ার্ড জেনারেট করুন: openssl rand -hex 32
# ============================================================
REDIS_PASSWORD=

# ============================================================
# এই অ্যাপের নিজের পাবলিক ঠিকানা — Evolution কে বলা হয় এখানে webhook পাঠাতে
# (instance-লেভেল webhook, VPS এর শেয়ার্ড Evolution সার্ভারের গ্লোবাল কনফিগ স্পর্শ করে না)
# ============================================================
APP_URL=https://wa.srv1980546.hstgr.cloud

# সরাসরি ব্রাউজার থেকে ভিজিট হওয়া পাবলিক ঠিকানা (উপরের APP_URL docker-internal/Evolution-এর
# জন্য, এটা আলাদা) — পাসওয়ার্ড রিসেট লিংক, sitemap.xml, robots.txt এখান থেকে URL বানায়
APP_PUBLIC_URL=https://wa.srv1980546.hstgr.cloud

# ============================================================
# বিলিং পেজে দেখানোর জন্য — ইউজাররা এই নাম্বারে Send Money করবে
# ============================================================
BKASH_RECEIVE_NUMBER=
NAGAD_RECEIVE_NUMBER=

# ============================================================
# সাপোর্ট — সাইডবার আর পাবলিক মার্কেটিং সাইটের (website ব্রাঞ্চ, Gen Z CRM) ফুটার/contact
# পেজে দেখানো হয়। নাম্বার দেশের কোড সহ, + ছাড়া (যেমন 8801XXXXXXXXX)। খালি রাখলে সংশ্লিষ্ট
# লিংকটাই দেখাবে না।
# ============================================================
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=

# ============================================================
# লগইন/সাইনআপের সোশ্যাল বাটন (google,facebook,linkedin) — কমা দিয়ে; খালি = একটাও না
# Supabase এ provider সেটআপ না হওয়া পর্যন্ত সংশ্লিষ্ট নাম বাদ দিন
# ============================================================
NEXT_PUBLIC_SOCIAL_LOGIN=google,facebook,linkedin
