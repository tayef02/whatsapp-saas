# Supabase প্রজেক্ট সেটিংস > API থেকে এই মানগুলো কপি করুন
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# শুধু server-side কোডে ব্যবহার হবে (RLS bypass করে), browser এ কখনো পাঠাবেন না
SUPABASE_SERVICE_ROLE_KEY=

# লোকাল ডেভেলপমেন্টে docker-compose এর Redis (webhook queue এর জন্য)
REDIS_URL=redis://localhost:6379

# নতুন WhatsApp নাম্বার কানেক্ট করার সময় Evolution কে বলা হয় এই ঠিকানার
# /api/webhooks/evolution এ ইভেন্ট পাঠাতে (instance-লেভেল webhook)
# লোকাল ডেভে: http://host.docker.internal:3000 (Evolution Docker থেকে host এ পৌঁছাতে)
APP_URL=http://host.docker.internal:3000

# বিলিং পেজে দেখানোর জন্য — এই নাম্বারে ইউজাররা Send Money করবে
BKASH_RECEIVE_NUMBER=
NAGAD_RECEIVE_NUMBER=

# Messenger চ্যানেল (Phase M0 — শুধু কাঠামো, আসল লজিক এখনো নেই)। false/খালি থাকলে সাইডবারে
# চ্যানেল সুইচার, Messenger মেনু আর /dashboard/messenger/* রুট সম্পূর্ণ লুকানো থাকে (404)।
# M1 এ Meta App Review অনুমোদন পেলে true করা হবে।
NEXT_PUBLIC_MESSENGER_ENABLED=false
