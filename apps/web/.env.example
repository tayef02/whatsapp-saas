# Supabase প্রজেক্ট সেটিংস > API থেকে এই মানগুলো কপি করুন
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# শুধু server-side কোডে ব্যবহার হবে (RLS bypass করে), browser এ কখনো পাঠাবেন না
SUPABASE_SERVICE_ROLE_KEY=

# লোকাল ডেভেলপমেন্টে docker-compose এর Redis (webhook queue এর জন্য)
REDIS_URL=redis://localhost:6379

# নতুন WhatsApp নাম্বার কানেক্ট করার সময় Evolution কে বলা হয় এই ঠিকানার
# /api/webhooks/evolution এ ইভেন্ট পাঠাতে (instance-লেভেল webhook)
# লোকাল ডেভে: http://host.docker.internal:3000 (Evolution Docker থেকে host এ পৌঁছাতে)
APP_URL=http://host.docker.internal:3000

# অ্যাপের পাবলিক ব্রাউজার-ফেসিং ঠিকানা (APP_URL এর মতো docker-internal না — এটা সরাসরি
# ইউজারের ব্রাউজার থেকে ভিজিট হয়) — পাসওয়ার্ড রিসেট ইমেইলের লিংক বানাতে ব্যবহার হয়।
# লোকাল ডেভে: http://localhost:3000। লাইভে: আপনার আসল ডোমেইন, যেমন https://app.yourdomain.com
APP_PUBLIC_URL=http://localhost:3000

# বিলিং পেজে দেখানোর জন্য — এই নাম্বারে ইউজাররা Send Money করবে
BKASH_RECEIVE_NUMBER=
NAGAD_RECEIVE_NUMBER=

# সাইডবারের নিচে "সহায়তা" লিংক, আর পাবলিক মার্কেটিং সাইটের (Gen Z CRM, /contact ও ফুটার)
# সাপোর্ট লিংক — শুধু নাম্বার (দেশের কোড সহ, + ছাড়া), যেমন 8801XXXXXXXXX। খালি রাখলে
# লিংকটাই দেখাবে না
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# পাবলিক মার্কেটিং সাইটের (/contact ও ফুটার) সাপোর্ট ইমেইল। খালি রাখলে লিংকটাই দেখাবে না
NEXT_PUBLIC_SUPPORT_EMAIL=

# Messenger চ্যানেল। false/খালি থাকলে সাইডবারে চ্যানেল সুইচার, Messenger মেনু আর
# /dashboard/messenger/* রুট সম্পূর্ণ লুকানো থাকে (404)। Meta App Review অনুমোদন পেলে true করা হবে।
NEXT_PUBLIC_MESSENGER_ENABLED=false

# Meta for Developers > আপনার App > Settings > Basic থেকে এই দুইটা
MESSENGER_APP_ID=
MESSENGER_APP_SECRET=

# Messenger OAuth redirect_uri বানাতে ব্যবহার হয় — Facebook এই URL ব্রাউজারে সরাসরি খোলে,
# তাই এটা অবশ্যই পাবলিক HTTPS হতে হবে, শেষে / ছাড়া (APP_URL এখানে কাজ করবে না — সেটা
# docker-internal http হতে পারে, শুধু WhatsApp webhook এর জন্য)।
# লোকাল ডেভে: ngrok/cloudflared টানেলের https URL। লাইভে: আপনার আসল ডোমেইন, যেমন
# https://app.yourdomain.com
MESSENGER_PUBLIC_URL=

# Meta for Developers > আপনার App > Messenger > Settings > Webhooks এ "Verify Token" হিসেবে
# আপনি নিজে একটা যেকোনো র‍্যান্ডম স্ট্রিং বসাবেন, এখানেও ঠিক সেটাই বসাতে হবে (দুই জায়গায় মিলতে হবে)
MESSENGER_WEBHOOK_VERIFY_TOKEN=
